|            /* mwcc `clz x, x`; ARM CLZ returns 32 for 0, and so does MATH_CountLeadingZerosFunc's C fallback.
|               __builtin_clz(0) is undefined, so the zero case is explicit (GCC still emits a bare CLZ). */
|            SDK_INLINE u32 MATH_CountLeadingZerosInline (u32 x)
|            {
|                return x ? (u32)__builtin_clz(x) : 32u;
|            }
