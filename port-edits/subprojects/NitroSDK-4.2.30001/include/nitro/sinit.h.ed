|    /* SDK_GCC: mwcc collects NitroStaticInit into a dedicated .sinit section that the overlay loader walks. Same here: a one-word
|       table in the ".sinit" section, which overlay_map.ld gathers per overlay (.ovl<N>.sinit) and hw_ovl.c runs at FS_StartOverlay.
|       34 overlays of this game carry one (tools/overlay_map.py checks the set). */
|    static void NitroStaticInit(void);
|    static void * NitroStaticInit_[] __attribute__((section(".sinit"), used)) = { NitroStaticInit };
