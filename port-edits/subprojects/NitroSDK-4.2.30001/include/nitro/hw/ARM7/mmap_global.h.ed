|#if defined(SDK_GCC) && !defined(SDK_ASM)
|/* 3DS port (phase 1 bet 1.5): the ARM7 sound driver runs on the ARM11 next to the ARM9 code, so its register accesses (reg_SND_*, REG_*_ADDR)
|   go to the same host-side I/O register block as the ARM9's (nitro/hw/ARM9/mmap_global.h; array defined in source/hw/hw_sys.c).
|   HW_SND_PTR_MIN: the pointer-versus-command-id bound of snd_command.c / snd_bank.c (a command word below it is a message id, not a host address). */
|#include <nitro/types.h>
|#define HW_REGS_SIZE            0x100020
|typedef struct HwRegs {
|    u8 b[HW_REGS_SIZE];
|} __attribute__((aligned(32))) HwRegs;
|extern HwRegs g_hwregs;
|#define HW_IOREG                ((u32)(&g_hwregs))
|#define HW_IOREG_END            (HW_IOREG + HW_REGS_SIZE)
|#define HW_SND_PTR_MIN          0x00100000
|#else
@42 insert-before 1
|#endif
