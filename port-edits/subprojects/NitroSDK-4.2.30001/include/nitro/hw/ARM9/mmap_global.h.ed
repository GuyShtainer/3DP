@12 insert-before 31
|#if defined(SDK_GCC) && !defined(SDK_ASM)
|/* 3DS port (phase 1 bet 1.3): the DS memory map redirected to host-side arrays.
|   Every region keeps its DS size and its DS internal layout; only the base address changes, from
|   a literal DS address to the address of one array (the same trick the stock HW_DTCM already uses).
|   Because every REG_*_ADDR / reg_* macro and every HW_*_BUF is "base + DS offset", redirecting the base
|   redirects all 329 register macros and the whole system-work page without touching them.
|   Table: the private design notes. Arrays are defined in source/hw/hw_sys.c. */
|#include <nitro/types.h>
|#define HW_REGS_SIZE            0x100020        /* highest ARM9 register: REG_MCD1 at +0x100010 */
|typedef struct HwRegs {
|    u8 b[HW_REGS_SIZE];
|} __attribute__((aligned(32))) HwRegs;
|extern HwRegs g_hwregs;                         /* 0x04000000.. : the I/O register block */
|extern u8 g_hwmainmem[];                        /* 0x02000000.. : 4 MB main RAM (game heaps, arenas) */
|extern u8 g_hwsys[];                            /* 0x027ff000.. : 4 KB shared page + system work (HW_MAIN_MEM_SYSTEM at +0xc00) */
|extern u8 g_hwitcm[];                           /* 0x01ff8000.. : 32 KB ITCM */
|extern u8 g_hwwram[];                           /* 0x037f8000.. : 32 KB shared WRAM window */
|extern u8 g_hwpltt[];                           /* 0x05000000.. : main BG/OBJ + sub BG/OBJ palettes, 0x800 */
|extern u8 g_hwvram_bg[];                        /* 0x06000000.. : main BG VRAM window, 512 KB */
|extern u8 g_hwvram_dbbg[];                      /* 0x06200000.. : sub BG VRAM window, 128 KB */
|extern u8 g_hwvram_obj[];                       /* 0x06400000.. : main OBJ VRAM window, 256 KB */
|extern u8 g_hwvram_dbobj[];                     /* 0x06600000.. : sub OBJ VRAM window, 128 KB */
|extern u8 g_hwvram_lcdc[];                      /* 0x06800000.. : LCDC VRAM window, 656 KB */
|extern u8 g_hwoam[];                            /* 0x07000000.. : main + sub OAM, 0x800 */
|extern u8 g_hwctrdg_rom[];                      /* 0x08000000.. : "no cartridge" sentinel, 16 bytes of 0xff */
|extern u8 g_hwbios[];                           /* 0xffff0000.. : 32 KB BIOS window (zero) */
|#ifndef HW_ARRAY_                              /* the host tests (tools/host-tests/build.sh) define it with a 64-bit-safe cast first */
|#define HW_ARRAY_(a)            ((u32)(a))
|#endif
|#endif
|
