|#if defined(SDK_GCC) && !defined(SDK_ASM)
|/* port: the sound code tells a pointer from an offset (snd_bank.c) or a command id (snd_command.c) by comparing against the DS main RAM
|   base. g_hwmainmem no longer sits at that base, so the comparison uses this explicit bound instead: offsets and command ids are below
|   it (the largest wave archive is 458 564 bytes; command ids are < 64), every host pointer is above it (the 3DS process image, heap,
|   stack and linear memory all start at or above 0x00100000). hw_sys_init asserts both sides. */
|#define HW_SND_PTR_MIN          0x00100000
|#endif
