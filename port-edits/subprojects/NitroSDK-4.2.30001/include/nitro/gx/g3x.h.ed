@202 insert-before 14
|/* 3DS port (bet 2.4a): every GXSTAT read the game makes is also recorded as a trace-only RDBK entry (hw_dev_hooks.h); the mwcc build reads the register as before. */
|#ifdef SDK_GCC
|static inline u32 G3X_ReadGxstat_ (void)
|{
|	u32 v;
|	HWG3_Sync();
|	v = (u32)reg_G3X_GXSTAT;
|	HWG3_Readback(0x600u, 1u, &v);
|	return v;
|}
|#else
|#define G3X_ReadGxstat_()  ((u32)reg_G3X_GXSTAT)
|#endif
|
@204 insert-before 1
|	u32 st = G3X_ReadGxstat_();
