|void MTX_Copy33To44_ (const MtxFx33 *pSrc, MtxFx44 *pDst)
|{
|	pDst->_00 = pSrc->_00; pDst->_01 = pSrc->_01; pDst->_02 = pSrc->_02; pDst->_03 = 0;
|	pDst->_10 = pSrc->_10; pDst->_11 = pSrc->_11; pDst->_12 = pSrc->_12; pDst->_13 = 0;
|	pDst->_20 = pSrc->_20; pDst->_21 = pSrc->_21; pDst->_22 = pSrc->_22; pDst->_23 = 0;
|	pDst->_30 = 0;         pDst->_31 = 0;         pDst->_32 = 0;         pDst->_33 = 4096;
|}
|#endif
