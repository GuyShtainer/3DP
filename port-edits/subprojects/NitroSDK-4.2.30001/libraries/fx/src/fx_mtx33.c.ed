|void MTX_RotX33_ (MtxFx33 *pDst, fx32 sinVal, fx32 cosVal)
|{
|	pDst->_00 = 4096; pDst->_01 = 0;      pDst->_02 = 0;
|	pDst->_10 = 0;    pDst->_11 = cosVal; pDst->_12 = sinVal;
|	pDst->_20 = 0;    pDst->_21 = (fx32)(0u - (u32)sinVal); pDst->_22 = cosVal;
|}
|#endif
@133 insert-before 1
|#if defined(__MWERKS__) || defined(SDK_CW)
@150 insert-before 8
|#else
|void MTX_RotY33_ (MtxFx33 *pDst, fx32 sinVal, fx32 cosVal)
|{
|	pDst->_00 = cosVal; pDst->_01 = 0;    pDst->_02 = (fx32)(0u - (u32)sinVal);
|	pDst->_10 = 0;      pDst->_11 = 4096; pDst->_12 = 0;
|	pDst->_20 = sinVal; pDst->_21 = 0;    pDst->_22 = cosVal;
|}
|#endif
@154 insert-before 1
|#if defined(__MWERKS__) || defined(SDK_CW)
@169 insert-before 8
|#else
|void MTX_RotZ33_ (MtxFx33 *pDst, fx32 sinVal, fx32 cosVal)
|{
|	pDst->_00 = cosVal;  pDst->_01 = sinVal; pDst->_02 = 0;
|	pDst->_10 = (fx32)(0u - (u32)sinVal); pDst->_11 = cosVal; pDst->_12 = 0;
|	pDst->_20 = 0;       pDst->_21 = 0;      pDst->_22 = 4096;
|}
|#endif
