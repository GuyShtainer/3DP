|void MTX_RotY44_ (MtxFx44 *pDst, fx32 sinVal, fx32 cosVal)
|{
|	pDst->_00 = cosVal; pDst->_01 = 0;    pDst->_02 = (fx32)(0u - (u32)sinVal); pDst->_03 = 0;
|	pDst->_10 = 0;      pDst->_11 = 4096; pDst->_12 = 0;       pDst->_13 = 0;
|	pDst->_20 = sinVal; pDst->_21 = 0;    pDst->_22 = cosVal;  pDst->_23 = 0;
|	pDst->_30 = 0;      pDst->_31 = 0;    pDst->_32 = 0;       pDst->_33 = 4096;
|}
|#endif
