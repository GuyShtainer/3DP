|void MTX_Scale44_ (MtxFx44 *pDst, fx32 x, fx32 y, fx32 z)
|{
|	pDst->_00 = x; pDst->_01 = 0; pDst->_02 = 0; pDst->_03 = 0;
|	pDst->_10 = 0; pDst->_11 = y; pDst->_12 = 0; pDst->_13 = 0;
|	pDst->_20 = 0; pDst->_21 = 0; pDst->_22 = z; pDst->_23 = 0;
|	pDst->_30 = 0; pDst->_31 = 0; pDst->_32 = 0; pDst->_33 = 4096;
|}
|#endif
