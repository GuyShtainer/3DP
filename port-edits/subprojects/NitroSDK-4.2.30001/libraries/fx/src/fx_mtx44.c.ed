|void MTX_RotX44_ (MtxFx44 *pDst, fx32 sinVal, fx32 cosVal)
|{
|	pDst->_00 = 4096; pDst->_01 = 0;       pDst->_02 = 0;       pDst->_03 = 0;
|	pDst->_10 = 0;    pDst->_11 = cosVal;  pDst->_12 = sinVal;  pDst->_13 = 0;
|	pDst->_20 = 0;    pDst->_21 = (fx32)(0u - (u32)sinVal); pDst->_22 = cosVal;  pDst->_23 = 0;
|	pDst->_30 = 0;    pDst->_31 = 0;       pDst->_32 = 0;       pDst->_33 = 4096;
|}
|#endif
