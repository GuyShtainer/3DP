|void MTX_Transpose44_ (const MtxFx44 *pSrc, MtxFx44 *pDst)
|{
|	MtxFx44 t = *pSrc;
|
|	pDst->_00 = t._00; pDst->_01 = t._10; pDst->_02 = t._20; pDst->_03 = t._30;
|	pDst->_10 = t._01; pDst->_11 = t._11; pDst->_12 = t._21; pDst->_13 = t._31;
|	pDst->_20 = t._02; pDst->_21 = t._12; pDst->_22 = t._22; pDst->_23 = t._32;
|	pDst->_30 = t._03; pDst->_31 = t._13; pDst->_32 = t._23; pDst->_33 = t._33;
|}
|#endif
