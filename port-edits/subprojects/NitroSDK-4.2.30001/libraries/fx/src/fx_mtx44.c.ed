|void MTX_RotZ44_ (MtxFx44 *pDst, fx32 sinVal, fx32 cosVal)
|{
|	pDst->_00 = cosVal;  pDst->_01 = sinVal; pDst->_02 = 0;    pDst->_03 = 0;
|	pDst->_10 = (fx32)(0u - (u32)sinVal); pDst->_11 = cosVal; pDst->_12 = 0;    pDst->_13 = 0;
