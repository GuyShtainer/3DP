|void MTX_Identity43_ (MtxFx43 *pDst)
|{
|	pDst->_00 = 4096; pDst->_01 = 0;    pDst->_02 = 0;
|	pDst->_10 = 0;    pDst->_11 = 4096; pDst->_12 = 0;
|	pDst->_20 = 0;    pDst->_21 = 0;    pDst->_22 = 4096;
|	pDst->_30 = 0;    pDst->_31 = 0;    pDst->_32 = 0;
|}
|#endif
@23 insert-before 1
|#if defined(__MWERKS__) || defined(SDK_CW)
@39 insert-before 9
|#else
|void MTX_Copy43To44_ (const MtxFx43 *pSrc, MtxFx44 *pDst)
|{
|	pDst->_00 = pSrc->_00; pDst->_01 = pSrc->_01; pDst->_02 = pSrc->_02; pDst->_03 = 0;
|	pDst->_10 = pSrc->_10; pDst->_11 = pSrc->_11; pDst->_12 = pSrc->_12; pDst->_13 = 0;
|	pDst->_20 = pSrc->_20; pDst->_21 = pSrc->_21; pDst->_22 = pSrc->_22; pDst->_23 = 0;
|	pDst->_30 = pSrc->_30; pDst->_31 = pSrc->_31; pDst->_32 = pSrc->_32; pDst->_33 = 4096;
|}
|#endif
@40 insert-before 1
|#if defined(__MWERKS__) || defined(SDK_CW)
@54 insert-before 13
|#else
|void MTX_Transpose43_ (const MtxFx43 *pSrc, MtxFx43 *pDst)
|{
|	fx32 a = pSrc->_00, b = pSrc->_01, c = pSrc->_02;
|	fx32 d = pSrc->_10, e = pSrc->_11, f = pSrc->_12;
|	fx32 g = pSrc->_20, h = pSrc->_21, i = pSrc->_22;
|
|	pDst->_00 = a; pDst->_01 = d; pDst->_02 = g;
|	pDst->_10 = b; pDst->_11 = e; pDst->_12 = h;
|	pDst->_20 = c; pDst->_21 = f; pDst->_22 = i;
|	pDst->_30 = 0; pDst->_31 = 0; pDst->_32 = 0;
|}
|#endif
@77 insert-before 1
|#if defined(__MWERKS__) || defined(SDK_CW)
@91 insert-before 9
|#else
|void MTX_Scale43_ (MtxFx43 *pDst, fx32 x, fx32 y, fx32 z)
|{
|	pDst->_00 = x; pDst->_01 = 0; pDst->_02 = 0;
|	pDst->_10 = 0; pDst->_11 = y; pDst->_12 = 0;
|	pDst->_20 = 0; pDst->_21 = 0; pDst->_22 = z;
|	pDst->_30 = 0; pDst->_31 = 0; pDst->_32 = 0;
|}
|#endif
@105 insert-before 1
|#if defined(__MWERKS__) || defined(SDK_CW)
@123 insert-before 9
|#else
|void MTX_RotX43_ (MtxFx43 *pDst, fx32 sinVal, fx32 cosVal)
|{
|	pDst->_00 = 4096; pDst->_01 = 0;       pDst->_02 = 0;
|	pDst->_10 = 0;    pDst->_11 = cosVal;  pDst->_12 = sinVal;
|	pDst->_20 = 0;    pDst->_21 = (fx32)(0u - (u32)sinVal); pDst->_22 = cosVal;
|	pDst->_30 = 0;    pDst->_31 = 0;       pDst->_32 = 0;
|}
|#endif
@127 insert-before 1
|#if defined(__MWERKS__) || defined(SDK_CW)
@143 insert-before 9
|#else
|void MTX_RotY43_ (MtxFx43 *pDst, fx32 sinVal, fx32 cosVal)
|{
|	pDst->_00 = cosVal; pDst->_01 = 0;    pDst->_02 = (fx32)(0u - (u32)sinVal);
|	pDst->_10 = 0;      pDst->_11 = 4096; pDst->_12 = 0;
|	pDst->_20 = sinVal; pDst->_21 = 0;    pDst->_22 = cosVal;
|	pDst->_30 = 0;      pDst->_31 = 0;    pDst->_32 = 0;
|}
|#endif
@147 insert-before 1
|#if defined(__MWERKS__) || defined(SDK_CW)
@163 insert-before 9
|#else
|void MTX_RotZ43_ (MtxFx43 *pDst, fx32 sinVal, fx32 cosVal)
|{
|	pDst->_00 = cosVal;  pDst->_01 = sinVal; pDst->_02 = 0;
|	pDst->_10 = (fx32)(0u - (u32)sinVal); pDst->_11 = cosVal; pDst->_12 = 0;
|	pDst->_20 = 0;       pDst->_21 = 0;      pDst->_22 = 4096;
|	pDst->_30 = 0;       pDst->_31 = 0;      pDst->_32 = 0;
|}
|#endif
