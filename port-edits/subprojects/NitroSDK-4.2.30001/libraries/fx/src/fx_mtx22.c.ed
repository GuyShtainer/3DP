|void MTX_Rot22_ (MtxFx22 *pDst, fx32 sinVal, fx32 cosVal)
|{
|	pDst->_00 = cosVal;
|	pDst->_01 = sinVal;
|	pDst->_10 = (fx32)(0u - (u32)sinVal);
|	pDst->_11 = cosVal;
|}
|#endif
