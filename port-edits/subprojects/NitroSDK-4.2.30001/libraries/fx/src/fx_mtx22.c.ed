|void MTX_Transpose22_ (const MtxFx22 *pSrc, MtxFx22 *pDst)
|{
|	fx32 a = pSrc->_00, b = pSrc->_01, c = pSrc->_10, d = pSrc->_11;
|
|	pDst->_00 = a;
|	pDst->_01 = c;
|	pDst->_10 = b;
|	pDst->_11 = d;
|}
|#endif
