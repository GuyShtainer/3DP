|void MIi_CpuClearFast (u32 data, void *destp, u32 size)
|{
|    MIi_VRAM_TOUCH(destp, size);
|    u32 *d = (u32 *)destp;
|    u32 *blockEnd = (u32 *)((u8 *)destp + (size >> 5 << 5));
|    u32 *e = (u32 *)((u8 *)destp + size);
|    int i;
@261 insert-before 13
|    while (d < blockEnd) {
|        for (i = 0; i < 8; i++) {
|            d[i] = data;
|        }
|        d += 8;
|    }
|    while (d < e) {
|        *d++ = data;
|    }
|}
|#endif
