|/* The DS routines are ldm/stm chunks: each chunk is loaded in full before it is stored. */
|static void MIi_CopyChunk (const u32 *s, u32 *d, int n)
|{
|    u32 t[4];
|    int i;
@73 insert-before 21
|    for (i = 0; i < n; i++) {
|        t[i] = s[i];
|    }
|    for (i = 0; i < n; i++) {
|        d[i] = t[i];
|    }
|}
|
|void MIi_CpuClear16 (u16 data, void *destp, u32 size)
|{
|    MIi_VRAM_TOUCH(destp, size);
|    /* signed compare, size rounded up to even (as the asm) */
|    s32 i;
|
|    for (i = 0; i < (s32)size; i += 2) {
|        *(u16 *)((u8 *)destp + i) = data;
|    }
|}
|#endif
|
