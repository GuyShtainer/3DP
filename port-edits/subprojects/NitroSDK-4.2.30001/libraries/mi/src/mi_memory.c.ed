|/* 3DS port (bet 2.1b): the bulk writers mark the 1 KB VRAM dirty pages of their destination (source/hw/hw_vram.c); an address that is not VRAM is ignored.
|   Plain CPU stores and MI_Copy16B..MI_Copy36B stay unhooked by design. */
|#if defined(SDK_GCC) && defined(SDK_ARM9)
|#include <hw_dev_hooks.h>
|#define MIi_VRAM_TOUCH(d, n) HWVRAM_Touch((d), (n))
|#else
|#define MIi_VRAM_TOUCH(d, n) ((void)0)
|#endif
