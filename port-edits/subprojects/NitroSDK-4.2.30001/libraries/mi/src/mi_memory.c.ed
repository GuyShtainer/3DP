|    const u32 *s = (const u32 *)srcp;
|    u32 *d = (u32 *)destp;
|    u32 *blockEnd = (u32 *)((u8 *)destp + (size >> 5 << 5));
|    u32 *e = (u32 *)((u8 *)destp + size);
|    u32 t[8];
|    int i;
@307 insert-before 17
|    while (d < blockEnd) {
|        for (i = 0; i < 8; i++) {
|            t[i] = s[i];
|        }
|        for (i = 0; i < 8; i++) {
|            d[i] = t[i];
|        }
|        s += 8;
|        d += 8;
|    }
|    while (d < e) {
|        *d++ = *s++;
|    }
|}
|#endif
