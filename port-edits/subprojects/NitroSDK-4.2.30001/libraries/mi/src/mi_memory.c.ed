|void MI_CpuFill8 (void *dstp, u8 data, u32 size)
|{
|    MIi_VRAM_TOUCH(dstp, size);
|    /* The DS code works on halfwords (read-modify-write of the neighbour byte);
|       the visible result for non-overlapping buffers is this byte loop. */
|    u8 *d = (u8 *)dstp;
|    u32 i;
@513 insert-before 7
|    for (i = 0; i < size; i++) {
|        d[i] = data;
|    }
|}
|#endif
|
|#if defined(__MWERKS__) || defined(SDK_CW)
@759 insert-before 15
|#else
|void MI_CpuCopy8 (const void *srcp, void *dstp, u32 size)
|{
|    MIi_VRAM_TOUCH(dstp, size);
|    /* Forward byte copy; overlapping buffers are not supported (the DS version is
|       halfword/word based and does not define overlap either). */
|    const u8 *s = (const u8 *)srcp;
|    u8 *d = (u8 *)dstp;
|    u32 i;
|
|    for (i = 0; i < size; i++) {
|        d[i] = s[i];
|    }
|}
|#endif
