|void MI_UncompressRL16 (const void *srcp, void *destp)
|{
|    const u8 *s = (const u8 *)srcp;
|    u8 *d = (u8 *)destp;
|    u32 hdr = (u32)s[0] | ((u32)s[1] << 8) | ((u32)s[2] << 16) | ((u32)s[3] << 24);
|    s32 size = (s32)(hdr >> 8);
|    u32 accum = 0;
|    u32 bpos = 0;
|
|    s += 4;
|    while (size > 0) {
|        u32 flag = *s++;
|        s32 len = (s32)(flag & 0x7F);
|        BOOL run = (flag & 0x80) != 0;
|        u32 v = 0;
|
|        if (run) {
|            len += 3;
|            v = *s++;
|        } else {
|            len += 1;
|        }
|        size -= len;
|        do {
|            if (!run) {
|                v = *s++;
|            }
|            accum |= v << bpos;
|            bpos ^= 8;
|            if (bpos == 0) {
|                *(u16 *)d = (u16)accum;
|                d += 2;
|                accum = 0;
|            }
|        } while (--len > 0);
|    }
|}
|#endif
