|void MI_UncompressLZ8 (const void *srcp, void *destp)
|{
|    const u8 *s = (const u8 *)srcp;
|    u8 *d = (u8 *)destp;
|    u32 hdr = (u32)s[0] | ((u32)s[1] << 8) | ((u32)s[2] << 16) | ((u32)s[3] << 24);
|    s32 size = (s32)(hdr >> 8);
|    BOOL ext = (hdr & 0x0F) != 0;
@158 insert-before 47
|    s += 4;
|    while (size > 0) {
|        u32 flags = *s++;
|        int i;
|
|        for (i = 0; i < 8; i++) {
|            if ((flags & 0x80) == 0) {
|                *d++ = *s++;
|                size--;
|            } else {
|                u32 b = *s;
|                u32 len;
|                u32 disp1;
|
|                if (!ext) {
|                    len = 3;
|                } else if ((b & 0xE0) != 0) {
|                    len = 1;
|                } else {
|                    s++;
|                    len = (b & 0xF) << 4;
|                    if (b & 0x10) {
|                        len = (len << 8) + ((u32)*s++ << 4) + 0x100;
|                    }
|                    len += 0x11;
|                    b = *s;
|                }
|                len += b >> 4;
|                s++;
|                disp1 = (((b & 0xF) << 8) | *s++) + 1;
|                size -= (s32)len;
|                do {
|                    *d = d[-(s32)disp1];
|                    d++;
|                } while (--len > 0);
|            }
|            if (size > 0) {
|                flags <<= 1;
|            } else {
|                break;
|            }
|        }
|    }
|}
|#endif
