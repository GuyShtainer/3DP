|void MI_UnfilterDiff8 (const void *srcp, void *destp)
|{
|    const u8 *s = (const u8 *)srcp;
|    u32 hdr = (u32)s[0] | ((u32)s[1] << 8) | ((u32)s[2] << 16) | ((u32)s[3] << 24);
|    s32 size = (s32)(hdr >> 8);
|    u32 sum = 0;
@543 insert-before 22
|    /* do-while, like the asm: at least one unit is written even for size 0 */
|    if ((hdr & 0xF) == 1) {
|        const u8 *sp = s + 4;
|        u8 *dp = (u8 *)destp;
|        do {
|            sum += *sp++;
|            size -= 1;
|            *dp++ = (u8)sum;
|        } while (size > 0);
|    } else {
|        const u16 *sp = (const u16 *)(s + 4);
|        u16 *dp = (u16 *)destp;
|        do {
|            sum += *sp++;
|            size -= 2;
|            *dp++ = (u16)sum;
|        } while (size > 0);
|    }
|}
|#endif
