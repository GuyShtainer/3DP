|void MI_UnpackBits (const void *srcp, void *destp, MIUnpackBitsParam *paramp)
|{
|    const u8 *s = (const u8 *)srcp;
|    u32 *d = (u32 *)destp;
|    s32 srcNum = paramp->srcNum;
|    u32 srcBits = paramp->srcBitNum;
|    u32 destBits = paramp->destBitNum;
|    u32 offset = paramp->destOffset;
|    u32 zeroOn = paramp->destOffset0_on;
|    u32 accum = 0;
|    u32 shift = 0;
@58 insert-before 25
|    /* as the asm: a partially filled output word at the end is not flushed */
|    while (srcNum-- > 0) {
|        u32 mask = 0xff >> (8 - srcBits);
|        u32 byte = *s++;
|        u32 pos;
|
|        for (pos = 0; pos < 8; pos += srcBits) {
|            u32 v = (byte & mask) >> pos;
|            if (v != 0 || zeroOn != 0) {
|                v += offset;
|            }
|            accum |= v << shift;
|            shift += destBits;
|            if (shift >= 32) {
|                *d++ = accum;
|                accum = 0;
|                shift = 0;
|            }
|            mask <<= srcBits;
|        }
|    }
|}
|#endif
|
