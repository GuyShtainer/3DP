|void MI_UncompressLZ16 (const void *srcp, void *destp)
|{
|    /* Output is assembled in a halfword accumulator (VRAM-safe). As on the DS,
|       a displacement of 1 reads memory that has not been written yet. */
|    const u8 *s = (const u8 *)srcp;
|    u8 *d = (u8 *)destp;
|    u32 hdr = (u32)s[0] | ((u32)s[1] << 8) | ((u32)s[2] << 16) | ((u32)s[3] << 24);
|    s32 size = (s32)(hdr >> 8);
|    BOOL ext = (hdr & 0x0F) != 0;
|    u32 accum = 0;
|    u32 bpos = 0;
@319 insert-before 65
|    s += 4;
|    while (size > 0) {
|        u32 flags = *s++;
|        int i;
|
|        for (i = 0; i < 8; i++) {
|            if ((flags & 0x80) == 0) {
|                accum |= (u32)*s++ << bpos;
|                size--;
|                bpos ^= 8;
|                if (bpos == 0) {
|                    *(u16 *)d = (u16)accum;
|                    d += 2;
|                    accum = 0;
|                }
|            } else {
|                u32 b = *s;
|                u32 len;
|                u32 disp1;
|                u32 sel;
|
|                if (!ext) {
|                    len = 3;
|                } else if ((b & 0xE0) != 0) {
|                    len = 1;
|                } else {
|                    s++;
|                    len = (b & 0xF) << 4;
|                    if (b & 0x10) {
|                        len = (len << 8) + ((u32)*s++ << 4) + 0x100;
|                    }
|                    len += 0x11;
|                    b = *s;
|                }
|                len += b >> 4;
|                s++;
|                disp1 = (((b & 0xF) << 8) | *s++) + 1;
|                sel = (8 - bpos) ^ ((disp1 & 1) << 3);
|                size -= (s32)len;
|                do {
|                    u32 off = (disp1 + ((8 - bpos) >> 3)) >> 1 << 1;
|                    u32 half;
|
|                    sel ^= 8;
|                    half = *(const u16 *)(d - off);
|                    accum |= ((half & (0xFFu << sel)) >> sel) << bpos;
|                    bpos ^= 8;
|                    if (bpos == 0) {
|                        *(u16 *)d = (u16)accum;
|                        d += 2;
|                        accum = 0;
|                    }
|                } while (--len > 0);
|            }
|            if (size > 0) {
|                flags <<= 1;
|            } else {
|                break;
|            }
|        }
|    }
|}
|#endif
