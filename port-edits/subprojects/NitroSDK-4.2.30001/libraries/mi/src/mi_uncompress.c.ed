|#if defined(__MWERKS__) || defined(SDK_CW)
@584 insert-before 38
|#else
|void MI_UnfilterDiff16 (const void *srcp, void *destp)
|{
|    const u8 *s = (const u8 *)srcp;
|    u32 hdr = (u32)s[0] | ((u32)s[1] << 8) | ((u32)s[2] << 16) | ((u32)s[3] << 24);
|    s32 size = (s32)(hdr >> 8);
|    const u16 *sp = (const u16 *)(s + 4);
|    u16 *dp = (u16 *)destp;
|    u32 sum = 0;
|
|    if ((hdr & 0xF) == 1) {
|        /* 8-bit units, 16-bit stores */
|        for (;;) {
|            u32 v = *sp++;
|            u32 lo;
|
|            size -= 2;
|            sum += v;
|            lo = sum & 0xFF;
|            sum += v >> 8;
|            *dp++ = (u16)(lo + (sum << 8));
|            if (size <= 1) {
|                break;
|            }
|        }
|        if (size == 1) {
|            sum += *sp;
|            *dp = (u16)(sum & 0xFF);
|        }
|    } else {
|        do {
|            sum += *sp++;
|            size -= 2;
|            *dp++ = (u16)sum;
|        } while (size > 0);
|    }
|}
|#endif
