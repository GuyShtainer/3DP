|void MI_UncompressHuffman (const void *srcp, void *destp)
|{
|    const u8 *s = (const u8 *)srcp;
|    u32 *d = (u32 *)destp;
|    u32 hdr = (u32)s[0] | ((u32)s[1] << 8) | ((u32)s[2] << 16) | ((u32)s[3] << 24);
|    u32 bits = hdr & 0xF;
|    s32 size = (s32)(hdr >> 8);
|    u32 perWord = (bits & 7) + 4;
|    const u8 *tree = s + 4;
|    const u32 *stream = (const u32 *)(const void *)(tree + ((u32)tree[0] + 1) * 2);
|    u32 node = 1;
|    u32 accum = 0;
|    u32 count = 0;
@407 insert-before 30
|    while (size > 0) {
|        u32 word = *stream++;
|        int i;
|
|        for (i = 0; i < 32; i++) {
|            u32 bit = (word >> 31) & 1;
|            u32 nb = tree[node];
|
|            node = (node & ~1u) + (((nb & 0x3F) + 1) << 1) + bit;
|            if (((nb << bit) & 0x80) != 0) {
|                accum = (accum >> bits) | ((u32)tree[node] << (32 - bits));
|                node = 1;
|                count++;
|                if (count == perWord) {
|                    *d++ = accum;
|                    size -= 4;
|                    count = 0;
|                }
|            }
|            if (size > 0) {
|                word <<= 1;
|            } else {
|                break;
|            }
|        }
|    }
|}
|#endif
