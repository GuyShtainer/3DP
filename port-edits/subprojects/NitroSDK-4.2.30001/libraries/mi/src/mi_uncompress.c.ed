|void MI_UncompressRL8 (const void *srcp, void *destp)
|{
|    const u8 *s = (const u8 *)srcp;
|    u8 *d = (u8 *)destp;
|    u32 hdr = (u32)s[0] | ((u32)s[1] << 8) | ((u32)s[2] << 16) | ((u32)s[3] << 24);
|    s32 size = (s32)(hdr >> 8);
|
|    s += 4;
|    while (size > 0) {
|        u32 flag = *s++;
|        s32 len = (s32)(flag & 0x7F);
|
|        if ((flag & 0x80) == 0) {
|            len += 1;
|            size -= len;
|            do {
|                *d++ = *s++;
|            } while (--len > 0);
|        } else {
|            u8 v;
|            len += 3;
|            size -= len;
|            v = *s++;
|            do {
|                *d++ = v;
|            } while (--len > 0);
|        }
|    }
|}
|#endif
