|#if defined(SDK_GCC)
|/* 3DS port: HW_LCDC_VRAM_x is the address of a host array, not a constant, so the table cannot hold address >> 12.
|   It holds the 4 KB-slot offset from HW_LCDC_VRAM plus one (0 = "no block"); TEXBASE() turns it back into an address. */
|#define TEXBLK(a)   ((u16)((((a) - HW_LCDC_VRAM) >> 12) + 1))
|#define TEXBASE(b)  ((b) ? (u32)(HW_LCDC_VRAM + ((u32)((b) - 1) << 12)) : 0u)
|#else
|#define TEXBLK(a)   ((u16)((a) >> 12))
|#define TEXBASE(b)  ((u32)((b) << 12))
|#endif
