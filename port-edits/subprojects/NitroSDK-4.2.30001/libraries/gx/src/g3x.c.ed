|#else
|static void GXi_NopClearFifo128_ (void *pDest)
|{
|    static const u32 nops[16];   /* 3DS port (bet 2.1a): 128 NOP words into the GX FIFO, see source/hw/hw_gx.c */
|
|    if (MIi_IS_G3_PORT(pDest)) {
|        int k;
|
|        for (k = 0; k < 8; k++) {
|            HWG3_Words(MIi_G3_PORT_OFS(pDest), nops, 16, HWG3_MODE_FIFO);
|        }
|        return;
|    }
|    volatile u32 *d = (volatile u32 *)pDest;
|    int i;
|
|    for (i = 0; i < 32; i++) {
|        d[0] = 0;
|        d[1] = 0;
|        d[2] = 0;
|        d[3] = 0;
|    }
|}
|#endif
