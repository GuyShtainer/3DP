|static __attribute__((unused)) void OSi_CpuClear32 (u32 data, void *destp, u32 size)
|{
|    /* kept for the CW build's OSi_DoBoot; unused once that body is the HWOS_DoBoot hook */
|    u32 *d = (u32 *)destp;
