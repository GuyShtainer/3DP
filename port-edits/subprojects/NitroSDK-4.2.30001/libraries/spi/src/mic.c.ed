|static void MicWaitBusy (void)
|{
|    /* Spins until the lock word is released by the callback side. 3DS port: the ARM7's answer is a word in the PXI FIFO and nothing delivers the
|       IRQ inside a spin on the same thread of control, so drain it here (as PMi_WaitBusy and TP_WaitBusy do). */
|    while (*(volatile u32 *)&micWork.lock == MIC_LOCK_ON) {
|        PXIi_HandlerRecvFifoNotEmpty();
|    }
|}
|#endif
